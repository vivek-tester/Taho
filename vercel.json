{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.taho.co.in"
        }
      ],
      "destination": "https://taho.co.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|privacy\\.html|terms\\.html|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
